# Echo-Bio currently qualifies one public provider profile only.
# Copy this file to .env for your own shell tooling, or export the values directly.
# Never commit .env. Echo-Bio's commands read the API key from the process environment.
DEEPSEEK_API_KEY=
ECHO_BIO_MODEL=deepseek-flash
ECHO_BIO_BASE_URL=https://api.deepseek.com
