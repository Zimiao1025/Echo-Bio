+    # The following methods are deliberately identity/no-op extension seams.  They
+    # keep Biomni independent from any harness implementation while allowing an
+    # adapter (for example Echo-Bio) to observe or project requests and raw tool
+    # results.  Subclasses must fail open to these baseline values.
+    def _on_run_start(self, run_identity: dict[str, str], prompt: str) -> None:
+        pass
+
+    def _before_model_request(self, messages: list[BaseMessage]) -> list[BaseMessage]:
+        return messages
+
+    def _after_model_response(self, response: Any, requested_messages: list[BaseMessage]) -> None:
+        pass
+
+    def _before_execution(self, code: str, language: str) -> str:
+        return code
+
+    def _after_execution(self, code: str, language: str, raw_result: str) -> str:
+        """Observe a full result before Biomni applies its 10K projection."""
+        return raw_result
+
+    def _project_execution_result(self, result: str) -> str:
+        """Apply Biomni's legacy provider-visible observation projection."""
+        if len(result) > 10000:
+            return (
+                "The output is too long to be added to context. Here are the first 10K characters...\n"
+                + result[:10000]
+            )
+        return result
+
+    def _before_finalize(self, content: str) -> str:
+        return content
+
+    def _on_run_end(self, run_identity: dict[str, str], status: str, final_content: str | None) -> None:
+        pass
+
+    def _new_run_identity(
+        self,
+        *,
+        run_id: str | None = None,
+        attempt_id: str | None = None,
+        session_id: str | None = None,
+    ) -> dict[str, str]:
+        """Create the run/attempt/session identity used by the LangGraph thread."""
+        identity = {
+            "run_id": run_id or str(uuid4()),
+            "attempt_id": attempt_id or str(uuid4()),
+            "session_id": session_id or str(uuid4()),
+        }
+        self.run_identity = identity
+        # The Python REPL is currently process-global.  Recording its owner makes
+        # that limitation explicit without changing baseline persistence semantics.
+        self.python_namespace_owner_attempt_id = identity["attempt_id"]
+        return identity
